# Copy to .envrc, fill in and run `direnv allow`. Never commit .envrc.
# Free GBIF account, needed to request occurrence downloads.
# GBIF has no API key. Use the account username, not the email, and its password.
export GBIF_USERNAME=
export GBIF_PASSWORD=
export GBIF_EMAIL=
# Open-Meteo needs no login for the free API.

# Local SporaMeteo Django and PostGIS settings. Keep these values local.
export SPORAMETEO_DJANGO_SECRET_KEY=replace-with-a-local-secret
# runserver serves CSS and JavaScript only when debug is on. Keep it on locally.
export SPORAMETEO_DEBUG=true
export SPORAMETEO_DB_NAME=sporameteo
export SPORAMETEO_DB_USER=sporameteo
export SPORAMETEO_DB_PASSWORD=replace-with-a-local-password
export SPORAMETEO_DB_HOST=127.0.0.1
export SPORAMETEO_DB_PORT=5542
export SPORAMETEO_ALLOWED_HOSTS=127.0.0.1,localhost
export SPORAMETEO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
# Add the laptop Tailscale hostname after checking `tailscale status`.
# export SPORAMETEO_ALLOWED_HOSTS=127.0.0.1,localhost,laptop.tailnet-name.ts.net
# export SPORAMETEO_CSRF_TRUSTED_ORIGINS=https://laptop.tailnet-name.ts.net

# macOS uses Rasterio's bundled GDAL to avoid a second Arrow library.
# Use SPORAMETEO_GDAL_LIBRARY_PATH only for a compatible custom GDAL build.
# export GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib

# Use the uv project environment, Python 3.14, for python3 and tools.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin
